{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "dockerfile": {
      "command": ["./pocketbase", "serve", "--http=0.0.0.0:8091", "--dir=/app/pb_data"]
    },
    "environments": {
      "production": {
        "variables": {
          "RAILWAY_RUN_UID": "0"
        }
      }
    }
  }
}
